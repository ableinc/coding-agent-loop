[Unit]
Description=coding-agent-loop — autonomous GitHub issue to draft PR agent
Documentation=https://github.com/ableinc/coding-agent-loop
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/coding-agent-loop
ExecStart=/opt/coding-agent-loop/bin/coding-agent-loop --config /opt/coding-agent-loop/config.json
Restart=on-failure
RestartSec=30s

# SIGTERM makes the loop stop claiming and drain whatever is in flight, so give
# it longer than one run timeout before killing it.
KillSignal=SIGTERM
TimeoutStopSec=50m

# The agent runs Claude Code with bypassPermissions against host worktrees, so
# it can do anything this user can. It runs as {{USER}} because gh and Claude
# Code store their auth under that account's home — a different user has no
# credentials to use. Keep the rest of the filesystem read-only.
User={{USER}}
Group={{GROUP}}
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/coding-agent-loop {{HOME}}/.agent-loop
PrivateTmp=true
NoNewPrivileges=true

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
