*.db
*.db-journal
*.db-wal
*.db-shm
/work/
/repos/
/logs/

# Go
/vendor/
go.work
go.work.sum

# Editors / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Local env / secrets
.env
.env.*
*.pem
*.key
